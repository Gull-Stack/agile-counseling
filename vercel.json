{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.agilecounseling.com"
        }
      ],
      "destination": "https://agilecounseling.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:dir*/index.html",
      "destination": "/:dir*/",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/brand-facts.json",
      "destination": "/.well-known/brand-facts.json"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon-32.png"
    }
  ]
}
